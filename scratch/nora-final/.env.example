# ---------------------------------------------------------------------------
# LiveKit connection
# ---------------------------------------------------------------------------
# Local / self-host:
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
#
# LiveKit Cloud: do NOT put LIVEKIT_URL, LIVEKIT_API_KEY, or LIVEKIT_API_SECRET
# in the file you pass to `lk agent create --secrets-file` — Cloud injects them.
# Use `deploy.secrets.env.example` → `deploy.secrets.env` for that (no localhost URL).
# If your shell still has LIVEKIT_URL=ws://localhost from this file, unset it before `lk`
# or you get: invalid project URL [ws://localhost:7880]
# (See https://docs.livekit.io/deploy/agents/secrets/ )
# For local *dev* against a Cloud project, use your project WebSocket URL, e.g.:
# LIVEKIT_URL=wss://<your-subdomain>.livekit.cloud

# Worker identity (matches agent dispatch; keep stable across deploys)
NORA_AGENT_NAME=nora-final-agent

# ---------------------------------------------------------------------------
# Interruption / turn behavior
# ---------------------------------------------------------------------------
# Self-host: "vad" is the safe default.
# LiveKit Cloud: "adaptive" is often a good fit (set via Cloud secrets if desired).
NORA_INTERRUPTION_MODE=vad
NORA_FALSE_INTERRUPTION_TIMEOUT_SEC=2
NORA_RESUME_FALSE_INTERRUPTION=true
NORA_INTERRUPTION_MIN_WORDS=2

# Optional telephony
SIP_TRUNK_ID=

# ---------------------------------------------------------------------------
# Job metadata defaults
# ---------------------------------------------------------------------------
# Defaults are defined in code (`DEFAULT_CALL_METADATA` in `nora_agent/workflow.py`)
# so local tests run without dispatch metadata.

# ---------------------------------------------------------------------------
# LLM / STT / TTS (worker session — same as sara-agent; NORA_*, or reuse SARA_*)
# ---------------------------------------------------------------------------
# LLM: LiveKit Cloud Inference (uses LIVEKIT_API_KEY / LIVEKIT_API_SECRET; no OpenAI key needed).
NORA_LLM_MODEL=openai/gpt-4.1-mini
# SARA_LLM_MODEL=openai/gpt-4.1-mini

# STT: deepgram | soniox
NORA_STT_PROVIDER=deepgram
NORA_STT_LANGUAGE=ar
NORA_DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_API_KEY=

# SONIOX_API_KEY=
# NORA_SONIOX_MODEL=stt-rt-v4
# NORA_SONIOX_LANGUAGE_HINTS=ar
# NORA_SONIOX_MAX_ENDPOINT_DELAY_MS=500
# NORA_SONIOX_ENABLE_LANGUAGE_IDENTIFICATION=true
# NORA_SONIOX_ENABLE_SPEAKER_DIARIZATION=false

# TTS: faseeh (default) | cartesia | elevenlabs | fishaudio
NORA_TTS_PROVIDER=faseeh
NORA_TTS_VOICE_ID=
NORA_FASEEH_MODEL=faseeh-v1-preview
NORA_FASEEH_STABILITY=0.5
NORA_FASEEH_SPEED=1.0
FASEEH_API_KEY=

# NORA_TTS_PROVIDER=cartesia
# NORA_TTS_LANGUAGE=ar
# NORA_CARTESIA_MODEL=sonic-3
# CARTESIA_API_KEY=

# NORA_TTS_PROVIDER=elevenlabs
# NORA_ELEVENLABS_MODEL=eleven_turbo_v2_5
# ELEVEN_API_KEY=

# NORA_TTS_PROVIDER=fishaudio
# NORA_FISH_MODEL=s1
# NORA_FISH_REFERENCE_ID=
# NORA_FISH_LATENCY_MODE=balanced
# FISH_API_KEY=

# Optional: other app keys (not required for LiveKit Inference LLM)
OPENAI_API_KEY=

# Pytest: session + judge use the same LLM. When LIVEKIT_API_KEY + LIVEKIT_API_SECRET
# are set, tests use LiveKit Inference by default (set model id for Inference, e.g.):
# NORA_TEST_LLM_MODEL=openai/gpt-4.1-mini
# For OpenAI plugin tests without Inference, use gpt-4.1-mini and set OPENAI_API_KEY, or set:
# NORA_TEST_PREFER_INFERENCE=false
NORA_TEST_LLM_MODEL=openai/gpt-4.1-mini
NORA_TEST_PREFER_INFERENCE=true
NORA_TEST_LLM_API_KEY=
NORA_TEST_LLM_BASE_URL=

# Optional: higher Hugging Face rate limits during `download-files` (Docker build)
# HF_TOKEN=

LIVEKIT_EVALS_VERBOSE=1
